# ── Orb Mobile ────────────────────────────────────────────────────────────
# Copy this file to .env and fill it in.

# Your Google AI Studio key: https://aistudio.google.com/apikey
ORB_API_KEY=

# A long random string. When set, the API requires it and the phone asks for it
# once in Settings. Leave empty only on a trusted local network.
ORB_TOKEN=

# HTTP port
PORT=8000

# Where memory, history and reminders are stored
ORB_DATA_DIR=./server/data
